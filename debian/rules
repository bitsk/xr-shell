#!/usr/bin/make -f

export RUSTFLAGS := $(RUSTFLAGS) --remap-path-prefix=$(CURDIR)=/usr/src/xr-shell
export RUSTFLAGS += --remap-path-prefix=$(abspath $(CURDIR)/..)=/usr/src/openkylin-xr
ifneq ($(strip $(CARGO_HOME)),)
export RUSTFLAGS += --remap-path-prefix=$(abspath $(CARGO_HOME))=/usr/src/cargo
endif

%:
	dh $@ --buildsystem=none

XR_CARGO_TARGET_DIR ?= $(CURDIR)/target
XR_CARGO_BINARY_DIR = $(abspath $(XR_CARGO_TARGET_DIR))/$(if $(XR_CARGO_TARGET),$(XR_CARGO_TARGET)/)release

override_dh_auto_build:
	CARGO_TARGET_DIR="$(XR_CARGO_TARGET_DIR)" cargo $(if $(XR_CARGO_CONFIG),--config $(XR_CARGO_CONFIG)) build --offline --locked --release $(if $(XR_CARGO_TARGET),--target $(XR_CARGO_TARGET))
ifneq ($(XR_CARGO_BINARY_DIR),$(CURDIR)/target/release)
	mkdir -p target/release
	cp "$(XR_CARGO_BINARY_DIR)/xr-shell" "$(XR_CARGO_BINARY_DIR)/xr-shellctl" target/release/
endif

override_dh_auto_test:
	@echo "OpenXR rendering acceptance is recorded separately on the selected development target."

override_dh_auto_clean:
	CARGO_TARGET_DIR="$(CURDIR)/target" cargo clean

override_dh_shlibdeps:
	dh_shlibdeps $(if $(XR_CROSS_LIBDIR),-l$(XR_CROSS_LIBDIR)) -- $(if $(XR_CROSS_SHLIBS),-L$(XR_CROSS_SHLIBS))
