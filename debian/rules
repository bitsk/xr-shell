#!/usr/bin/make -f

export RUSTFLAGS := $(RUSTFLAGS) --remap-path-prefix=$(CURDIR)=/usr/src/xr-shell
ifneq ($(strip $(CARGO_HOME)),)
export RUSTFLAGS += --remap-path-prefix=$(CARGO_HOME)=/usr/src/cargo
endif

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	CARGO_TARGET_DIR="$(CURDIR)/target" cargo build --offline --locked --release

override_dh_auto_test:
	@echo "OpenXR rendering acceptance is performed in the development guest."

override_dh_auto_clean:
	CARGO_TARGET_DIR="$(CURDIR)/target" cargo clean
